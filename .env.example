# Optional — defaults work without a .env file.
# Copy to .env and adjust only what you need.

LOG_LEVEL=INFO

# Whisper inference
WHISPER_MODEL=small

# device: cpu | mps (Apple Silicon) | cuda
# On Apple Silicon Macs, the app defaults to mps + float16 automatically.
# WHISPER_DEVICE=mps
# WHISPER_COMPUTE_TYPE=float16

# Force CPU instead:
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
